---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "VERVE | Studio de Arquitetura & Interior Design" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content="Studio de arquitetura autoral focado em residências de alto padrão, edifícios corporativos e design de interiores atemporal." />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Arquitetura Sensorial, Rigor Geométrico e Espaços Atemporais." />
		<meta property="og:image" content="/images/hero-architecture.jpg" />
	</head>
	<body class="bg-[#090b0e] text-white">
		<slot />
	</body>
</html>
